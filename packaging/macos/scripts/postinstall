#!/bin/bash
set -euo pipefail

HOST_NAME="com.hzy9738.sidechat"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TARGET_ROOT="${ANNENG_INSTALL_ROOT:-}"
HOST_PATH="$TARGET_ROOT/Library/Application Support/Anneng Assistant/anneng-assistant-host"

# shellcheck disable=SC1091
source "$SCRIPT_DIR/config"

write_manifest() {
  local manifest_dir="$1"
  /bin/mkdir -p "$manifest_dir"
  /bin/cat >"$manifest_dir/$HOST_NAME.json" <<EOF
{
  "name": "$HOST_NAME",
  "description": "安能助手 Native Messaging Host",
  "path": "$HOST_PATH",
  "type": "stdio",
  "allowed_origins": ["chrome-extension://$EXTENSION_ID/"]
}
EOF
  /bin/chmod 0644 "$manifest_dir/$HOST_NAME.json"
}

add_force_install_policy() {
  local plist="$1"
  local entry="$EXTENSION_ID;$EXTENSION_UPDATE_URL"
  local buddy="/usr/libexec/PlistBuddy"
  /bin/mkdir -p "$(/usr/bin/dirname "$plist")"
  if [[ ! -f "$plist" ]]; then
    "$buddy" -c 'Add :ExtensionInstallForcelist array' "$plist"
  elif ! "$buddy" -c 'Print :ExtensionInstallForcelist' "$plist" >/dev/null 2>&1; then
    "$buddy" -c 'Add :ExtensionInstallForcelist array' "$plist"
  fi
  if "$buddy" -c 'Print :ExtensionInstallForcelist' "$plist" | /usr/bin/grep -Fq "$entry"; then
    return
  fi
  local index
  index="$("$buddy" -c 'Print :ExtensionInstallForcelist' "$plist" | /usr/bin/grep -c '^    ' || true)"
  "$buddy" -c "Add :ExtensionInstallForcelist:$index string $entry" "$plist"
  /bin/chmod 0644 "$plist"
}

case "$BROWSER" in
  chrome)
    write_manifest "$TARGET_ROOT/Library/Google/Chrome/NativeMessagingHosts"
    add_force_install_policy "$TARGET_ROOT/Library/Managed Preferences/com.google.Chrome.plist"
    ;;
  edge)
    write_manifest "$TARGET_ROOT/Library/Microsoft/Edge/NativeMessagingHosts"
    add_force_install_policy "$TARGET_ROOT/Library/Managed Preferences/com.microsoft.Edge.plist"
    ;;
  brave)
    write_manifest "$TARGET_ROOT/Library/Application Support/BraveSoftware/Brave-Browser/NativeMessagingHosts"
    add_force_install_policy "$TARGET_ROOT/Library/Managed Preferences/com.brave.Browser.plist"
    ;;
  ego)
    write_manifest "$TARGET_ROOT/Library/Application Support/Citro Labs/ego lite/NativeMessagingHosts"
    add_force_install_policy "$TARGET_ROOT/Library/Managed Preferences/com.citrolabs.ego.lite.plist"
    ;;
  chromium)
    write_manifest "$TARGET_ROOT/Library/Application Support/Chromium/NativeMessagingHosts"
    add_force_install_policy "$TARGET_ROOT/Library/Managed Preferences/org.chromium.Chromium.plist"
    ;;
  *)
    printf 'Unsupported browser component: %s\n' "$BROWSER" >&2
    exit 2
    ;;
esac

if [[ -z "$TARGET_ROOT" ]]; then /usr/bin/killall cfprefsd >/dev/null 2>&1 || true; fi
exit 0
